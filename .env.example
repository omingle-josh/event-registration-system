# PostgreSQL JDBC URL with no query string.
# The services append ?currentSchema=auth_db|event_db|registration_db themselves.
# SSL is required (sslmode=require). A hosted database such as Neon works.
# From Docker, do not use localhost; the database host must be reachable from the containers.
DB_URL=jdbc:postgresql://HOST:5432/DATABASE
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Shared by the API gateway and every backend service. Use a long random value.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Used when you run services on the host. Docker Compose overrides this.
EUREKA_SERVER_URL=http://localhost:8761/eureka/

# Required at startup for auth-service, even if you only use email and password.
# For Google sign-in, create an OAuth client and set the redirect URI to
# http://localhost:8080/login/oauth2/code/google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Required at startup for registration-service. Use Razorpay test keys for local payments.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Optional. Event descriptions fall back to a placeholder when this is empty.
GROQ_API_KEY=
